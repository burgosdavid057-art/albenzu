# ── Albenzu ────────────────────────────────────────────────────────────────
# Carpetas internas que no deben servirse por web.
RedirectMatch 404 ^/albenzu/(config|database|includes|data|docs)/

# Nada de listados de directorio.
Options -Indexes

# La base de datos y los volcados, fuera de alcance.
<FilesMatch "\.(sqlite|sqlite-journal|sql|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
